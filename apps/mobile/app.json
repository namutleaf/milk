{
  "expo": {
    "name": "MILK",
    "slug": "milk-camera",
    "scheme": "milk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milk.camera"
    },
    "android": {
      "package": "com.milk.camera",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "MILK가 사진을 촬영하려면 카메라 접근 권한이 필요해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "촬영한 사진을 앨범에서 보여주기 위해 접근 권한이 필요해요.",
          "savePhotosPermission": "촬영한 사진을 앨범에 저장하기 위해 권한이 필요해요.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
